# ------------------------------------------------------------------
# Ready-to-use local dev config — pairs with `docker compose up -d`.
# Copy this to .env and you only need to fill in ONE value: GEMINI_API_KEY.
#   cp .env.local.example .env
# ------------------------------------------------------------------

# --- Database (matches docker-compose.yml) ---
DATABASE_URL="postgresql://lecturecode:lecturecode@localhost:5432/lecturecode_pro?schema=public"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="local-dev-secret-change-me-1234567890"

# --- Dev Login: sign in with just a name + email, no OAuth app needed ---
# Leave GitHub/Google blank below — Dev Login covers local testing.
ENABLE_DEV_LOGIN="True"
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Google Gemini AI ---
# The ONE thing you must get yourself (free, ~30 seconds):
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# --- Redis rate limiting (matches docker-compose.yml's redis-http shim) ---
UPSTASH_REDIS_REST_URL="http://localhost:8079"
UPSTASH_REDIS_REST_TOKEN="local_dev_token"

# --- Judge0 CE code execution ---
JUDGE0_API_URL="https://ce.judge0.com"
